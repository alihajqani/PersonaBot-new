# =============================================================================
# PersonaBot deployment settings — shared by EVERY survey in this checkout.
#
# Nothing about a particular questionnaire belongs here: its form URL, provider
# and page budget live in surveys/<id>/survey.yaml. Pick the survey per command
# (`--survey <id>`, `make … SURVEY=<id>`) or set a default below.
# =============================================================================

# ===== SURVEY SELECTION =====
SURVEY=""                             # default survey id (a folder under surveys/)
# SURVEY_CONFIG=""                    # or an explicit YAML path; wins over SURVEY
# CLIENTS_DIR=""                      # client worktrees; default: ../clients

# ===== LLM =====
AI_PROVIDER="gemini"                  # gemini | vllm
GEMINI_API_KEY_1=""                   # add _2, _3 … for a larger lease pool
GEMINI_MODEL_NAME="gemini-2.5-pro"
# GEMINI_PROXY=""                     # http://host:port or socks5://host:port
                                      # (socks needs: pip install -e ".[socks]").
                                      # Scoped to the Gemini client only.
# Free tier binds on input tokens per minute per key — read the TPM column at
# https://ai.dev/rate-limit. 0 = no pacing (fine on a paid tier).
GEMINI_INPUT_TOKENS_PER_MINUTE=0
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3
AI_CALL_DELAY_SECONDS=0               # usually 0; raise on a free tier
PERSONA_BATCH_SIZE=10

# OpenAI-compatible endpoint (AI_PROVIDER=vllm)
VLLM_BASE_URL="http://localhost:8000/v1"
VLLM_MODEL_NAME=""
VLLM_API_KEY="EMPTY"

# ===== CONCURRENCY =====
CONCURRENT_LLM_TASKS=4                # in-flight generations
CONCURRENT_SUBMISSIONS=2              # in-flight browser submissions

# ===== BROWSER =====
# BASE_FORM_URL=""                    # FALLBACK ONLY, for a survey with no form.url
HEADLESS_MODE="True"
SLOW_MO=50
BROWSER_CHANNEL="chrome"              # empty = Playwright's bundled Chromium
BROWSER_INCOGNITO="True"
BROWSER_LOCALE="fa-IR"
BROWSER_TIMEZONE="Asia/Tehran"
BLOCK_HEAVY_ASSETS="True"             # abort images/fonts/media: faster on slow links
MAX_PAGES=40                          # default page budget; surveys set form.max_pages
SUBMISSION_DELAY_SECONDS=15
NAV_TIMEOUT_SECONDS=60                # per attempt
READY_TIMEOUT_SECONDS=45              # provider readiness gate, per attempt
BROWSER_MAX_ATTEMPTS=3                # route retries (capped at 2 without Tor)

# ===== TOR =====
# Chromium refuses SOCKS5 authentication, so circuits are isolated per
# SocksPort. List extra ports (also declared in torrc) to give concurrent
# submissions distinct exit IPs.
USE_TOR="False"
TOR_SOCKS_HOST="127.0.0.1"
TOR_SOCKS_PORT=9050
TOR_SOCKS_EXTRA_PORTS=""              # e.g. "9052,9053,9054"
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=""
TOR_CIRCUIT_COOLDOWN_SECONDS=60       # match MaxCircuitDirtiness in torrc
UNIQUE_EXIT_IPS="True"                # never submit one survey twice from one exit IP
EXIT_IP_MIN_GAP=0                     # >0: reuse an IP after N other submissions
                                      # (1 = never twice in a row)

# ===== OUTPUT =====
OUTPUT_DIR="output"                   # root; each survey writes output/<id>/
LOG_LEVEL="INFO"
