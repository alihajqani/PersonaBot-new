# ===== LLM =====
AI_PROVIDER="gemini"                  # gemini | vllm
GEMINI_API_KEY_1=""                   # add _2, _3 … for a larger lease pool
GEMINI_MODEL_NAME="gemini-2.5-pro"
# GEMINI_PROXY=""                     # scoped to the Gemini client, not os.environ
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3
AI_CALL_DELAY_SECONDS=0               # usually 0; raise on a free tier
PERSONA_BATCH_SIZE=10

# OpenAI-compatible endpoint (AI_PROVIDER=vllm)
VLLM_BASE_URL="http://localhost:8000/v1"
VLLM_MODEL_NAME=""
VLLM_API_KEY="EMPTY"

# ===== SURVEY =====
# The instrument. Everything survey-specific lives behind this path.
SURVEY_CONFIG="configs/surveys/_template.yaml"

# ===== CONCURRENCY =====
CONCURRENT_LLM_TASKS=4                # in-flight generations
CONCURRENT_SUBMISSIONS=2              # in-flight browser submissions

# ===== FORM / BROWSER =====
BASE_FORM_URL=""                      # required by phases 1 and 4 only
HEADLESS_MODE="True"
SLOW_MO=50
BROWSER_CHANNEL="chrome"              # empty = Playwright's bundled Chromium
MAX_PAGES=400                         # hard ceiling on form pagination. Porsline
                                      # shows one question per page, so this must
                                      # exceed the question count, not the
                                      # number of screens you expect.
SUBMISSION_DELAY_SECONDS=15

# ===== TOR =====
# Each browser context gets its own SOCKS credentials, so IsolateSOCKSAuth
# puts concurrent submissions on separate circuits and separate exit IPs.
USE_TOR="False"
TOR_SOCKS_HOST="127.0.0.1"
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=""

# ===== OUTPUT =====
OUTPUT_DIR="output"
LOG_LEVEL="INFO"
